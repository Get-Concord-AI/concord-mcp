{
  "description": "Concord inter-agent message delivery",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "concord inbox register"
          },
          {
            "type": "command",
            "command": "concord inbox observe"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "concord inbox observe"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|mcp__conductor__AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "concord inbox observe"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "concord inbox observe"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "concord inbox drain --from-hook --format post-tool-use"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "concord inbox drain --from-hook --format stop"
          },
          {
            "type": "command",
            "command": "concord inbox rewake",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "concord inbox observe"
          }
        ]
      }
    ]
  }
}
