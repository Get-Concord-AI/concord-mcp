        <mxCell id="title" value="Issue #180 — ciclo de vida del monitor concord-inbox y opciones de fix" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="10" width="740" height="30" as="geometry" />
        </mxCell>

        <!-- Happy path lane -->
        <mxCell id="lane1" value="Camino feliz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1020" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="SessionStart&#10;(source=startup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="95" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Claude Code arma&#10;monitor (experimental.monitors)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="95" width="190" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="watch-inbox.sh → drain --format monitor&#10;cada ~2s (heartbeat receiver)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="490" y="85" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="stdout → notificación&#10;en la sesión (único canal idle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="95" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- H2 lane: survives resume with stale env -->
        <mxCell id="lane2" value="H2 — el monitor SOBREVIVE al /resume (mismo proceso claude)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="1020" height="130" as="geometry" />
        </mxCell>
        <mxCell id="h2a" value="monitor armado con env&#10;CLAUDE_CODE_SESSION_ID = A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="215" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="h2b" value="/resume o /clear&#10;(misma sesión de proceso,&#10;nuevo session_id → agente B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="290" y="205" width="200" height="75" as="geometry" />
        </mxCell>
        <mxCell id="h2c" value="BUG: drain resuelve por env →&#10;sigue drenando inbox del&#10;agente A (obsoleto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="205" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="h2d" value="mensajes para B se acumulan;&#10;los de A se consumen a un&#10;sesión muerta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="215" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="h2fix" value="FIX H2: drain/watch consultan session_bindings&#10;(client_pid → agentId grabado por hooks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="300" width="480" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="h2a" target="h2b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="h2b" target="h2c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="h2c" target="h2d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="h2c" target="h2fix"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- H3 lane: monitor dies / never re-arms -->
        <mxCell id="lane3" value="H3′ — el monitor MUERE y no se rearma (bug upstream #111286)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1020" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h3a" value="monitor sale (exit / crash / kill)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="h3b" value="armedMonitorKeys (proceso claude)&#10;NUNCA se limpia → /resume,&#10;/reload-plugins no rearman" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="370" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="h3c" value="sesión idle SIN monitor:&#10;PostToolUse/Stop drenan solo&#10;con agente activo → silencio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="590" y="375" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="h3d" value="receiver_expires_at queda&#10;stale (~10s) → receiverActive()=false&#10;(señal detectable en hooks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="860" y="375" width="190" height="60" as="geometry" />
