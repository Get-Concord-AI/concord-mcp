        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="h3a" target="h3b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="h3b" target="h3c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="h3c" target="h3d"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Options -->
        <mxCell id="optsTitle" value="Opciones de fallback (DECISION GATE)" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="400" height="25" as="geometry" />
        </mxCell>

        <mxCell id="optA" value="A) REWAKE SELECTIVO (recomendado)&#10;inbox rewake espera si hostsRewake&#10;O receiver inactivo; waiter NO hace&#10;heartbeat → sin oscilación&#10;· cubre resume (Stop posterior)&#10;· hueco: muerte durante idle sin Stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="545" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="optB" value="B) REWAKE SIEMPRE&#10;todo Stop arma waiter en&#10;interactivas (como SDK)&#10;· cobertura total incluso&#10;muerte-en-idle&#10;· +1 proceso node/sesión siempre;&#10;contradice preferencia maintainer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="545" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="optC" value="C) SOLO VISIBILIDAD&#10;SessionStart/doctor avisa&#10;“sin receiver vivo” + docs&#10;+ link #111286&#10;· mínimo y seguro&#10;· el fallo sigue siendo manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="545" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="optD" value="D) RESPAWN DETACHED&#10;SessionStart spawnea&#10;watch-inbox.sh detached&#10;✗ NO VIABLE: stdout del&#10;proceso detached no llega a la&#10;sesión → drenaría a un vacío" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="830" y="545" width="230" height="140" as="geometry" />
        </mxCell>

        <!-- Identity mechanism note -->
        <mxCell id="idTitle" value="Mecanismo de identidad (H2) — recomendado: session_bindings existente (#366)" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="idNote" value="Alternativas: migración de esquema para guardar session_key cruda (más invasiva) · docs-only (deja el bug).&#10;El guard de frescura (binding.updatedAt >= inicio del monitor) + agents.get evita adopción de bindings de pid reutilizado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="735" width="1020" height="55" as="geometry" />
        </mxCell>

