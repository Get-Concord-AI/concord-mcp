<mxfile host="app.diagrams.net" agent="devin" version="24.0.0">
  <diagram id="cline-adapter" name="Cline adapter decisions">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Cline adapter — integration surface &amp; open decisions (issue #122)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="surfaces-label" value="Cline surfaces (all share one global MCP file)" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="Cline CLI&#10;(cline on PATH)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="vscode" value="VS Code / JetBrains / Desktop ext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="95" width="160" height="45" as="geometry" />
        </mxCell>

        <mxCell id="mcpfile" value="cline_mcp_settings.json&#10;~/.cline/data/settings/&#10;(CLINE_MCP_SETTINGS_PATH override)&#10;— GLOBAL ONLY, no project MCP —" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="cli" target="mcpfile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="vscode" target="mcpfile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="writes-label" value="What `concord setup` writes" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="D1 · Global MCP entry&#10;mcpServers.concord = { command: concord-mcp,&#10;env: { CONCORD_AGENT_KIND: 'cline' } }&#10;+ preserve unrelated servers/keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="235" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="D2 · Repo rules file&#10;.cline/rules/concord.md  (vs .clinerules/ vs both)&#10;+ instructions: agent_id, workspace_id, pull-only inbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="D3 · Lifecycle hooks (optional)&#10;.cline/hooks/TaskStart + UserPromptSubmit&#10;→ cline:&lt;hash(taskId)&gt; identity + busy-turn inbox inject&#10;(vs none / global ~/.cline/hooks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="425" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="D4 · Detection&#10;cline on PATH  OR  ~/.cline exists&#10;OR ~/Documents/Cline exists&#10;(covers CLI + extension-only installs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="runtime-label" value="Runtime behaviour (verified against cline 3.0.75 source)" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="400" y="210" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="MCP spawn&#10;env = process.env (SDK) or safe-list (ext) + config env;&#10;cwd = config.cwd or inherited process cwd&#10;→ CLI in repo = OK; extension = editor host cwd (wrong)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="235" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Repo targeting fallback&#10;tools accept workspace_id (ws_&lt;base64url(root)&gt;);&#10;rules tell agent to pass it;&#10;no ${workspaceFolder} expansion exists in Cline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="340" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="Identity&#10;CONCORD_AGENT_KIND=cline pinned;&#10;CONCORD_AGENT_ID only on SDK path;&#10;hook taskId → cline:&lt;hash&gt; if D3=yes;&#10;else agent passes agent_id per call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="435" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="Delivery = pull / busy only&#10;no idle wake-up verified → honest busyPull;&#10;UserPromptSubmit hook can inject inbox (busy turns)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="280" height="75" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Rejected alternatives: .cline/mcp.json (unsupported, issues #15546/#13596) · cwd:${workspaceFolder} (no expansion → spawn ENOENT) · CONCORD_REPO_ROOT baked (global file shared by all repos) · cline mcp add CLI (no --env flag for CONCORD_AGENT_KIND)" style="text;html=1;fontSize=11;fontColor=#666666;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="640" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
