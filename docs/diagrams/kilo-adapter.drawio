<mxfile host="app.diagrams.net">
  <diagram name="Kilo adapter" id="kilo-adapter">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="kilo" value="Kilo CLI&#10;(kilo / kilo run / TUI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cfg" value="~/.config/kilo/kilo.jsonc&#10;(JSONC, XDG-aware)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="adapter" value="Concord adapter&#10;src/install/adapters/kilo.ts&#10;+ kilo-config.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="80" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mcpadd" value="kilo mcp add concord&#10;--env CONCORD_AGENT_KIND=kilo" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="200" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="server" value="concord-mcp&#10;MCP server (stdio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="Identity: CONCORD_AGENT_ID&#10;(no session id from Kilo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="540" y="180" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="inbox" value="Durable inbox&#10;(pull + busy only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="540" y="280" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="kilo" target="cfg">
          <mxGeometry relative="1" as="geometry" />
