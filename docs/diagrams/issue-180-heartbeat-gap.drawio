<mxfile host="app.diagrams.net" agent="devin" version="24.0.0">
  <diagram name="issue-180-heartbeat-gap" id="issue-180-heartbeat-gap">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="PR #405 — Greptile P1: heartbeat fresco puede ocultar un monitor muerto" style="text;html=1;fontSize=17;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="140" y="10" width="820" height="30" as="geometry" />
        </mxCell>

        <!-- Timeline of the gap -->
        <mxCell id="tl" value="Línea temporal del hueco (sesión idle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1020" height="150" as="geometry" />
        </mxCell>
        <mxCell id="t0" value="T0: monitor muere&#10;(crash / SIGKILL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="105" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="T0..T0+10s: último heartbeat&#10;aún válido (receiverExpiresAt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="105" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Stop hook en la ventana:&#10;receiverAlive=true → rewake&#10;sale sin armar waiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="510" y="95" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="T0+10s: heartbeat expira.&#10;Sesión idle: ningún Stop vuelve&#10;a chequear → mensajes esperan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="790" y="105" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="te1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t0" target="t1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Options -->
        <mxCell id="optA" value="Opción A — waiter "guardian" (always-armed con compuerta)&#10;Cada Stop arma un waiter; este NO drena mientras receiverActive.&#10;Solo cuando el heartbeat expira empieza a drenar (toma el relevo).&#10;Cobertura total; 1 proceso extra por sesión (la opción B que se rechazó)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="optB" value="Opción B — re-chequeo único diferido&#10;Si hay heartbeat fresco, el rewake duerme hasta receiverExpiresAt,&#10;re-chequea una vez: muerto→espera mensajes; vivo→sale.&#10;Barato (~10s de proceso por Stop); cubre solo muertes cercanas al Stop." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="250" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="optC" value="Opción C — aceptar el hueco residual + documentar&#10;El hueco real es estrecho: exige que el monitor muera &lt;~10s antes de un Stop&#10;y que la sesión quede idle sin más Stops. Se autocura en el próximo turno.&#10;Cero procesos extra; coherente con la decisión "selective" ya tomada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="optD" value="Opción D — el monitor limpia su heartbeat al salir&#10;watch-inbox.sh trap EXIT → clearReceiver: la muerte ordenada no deja&#10;heartbeat fantasma. No cubre SIGKILL/crash (el lease expira solo en ~10s).&#10;Mitigación parcial sin cambiar la decisión de diseño." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="390" width="500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Mientras tanto, los otros 3 hallazgos P1 de Greptile (caché en /tmp compartido, reuso de ancestros entre clientes, floor de frescura que se envenena si el caché se borra) se corrigen en la misma pasada." style="text;html=1;fontSize=12;fontStyle=2;align=left;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1020" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
